# ─────────────────────────────────────────────────────────────────────────────
# SLI.pro / Wing — environment configuration
#
# In Azure, the SECRET values below are stored in Key Vault and injected at
# startup via the Container App's managed identity (set KEY_VAULT_URI). Locally,
# copy this file to `.env` and fill in the values. Any value set in the
# environment overrides the Key Vault copy.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development
# Port the API listens on. Azure Container Apps sets this automatically.
PORT=5000
# Serve the built SPA from this process. Leave unset: defaults to true in
# development, false in production (client is hosted on Azure Static Web Apps).
# SERVE_CLIENT=false

# --- Key Vault (Azure only) ---
# When set, secrets are fetched from this vault at startup.
# KEY_VAULT_URI=https://slipro-kv-stage.vault.azure.net/
# Client id of the user-assigned managed identity (Container Apps).
# AZURE_MANAGED_IDENTITY_CLIENT_ID=

# --- Database (SECRET) ---
# Azure Database for PostgreSQL Flexible Server connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "false" only for a local Postgres without TLS. Azure requires TLS.
DATABASE_SSL=true
# Optional connection pool size (default 10).
# DATABASE_POOL_MAX=10

# --- Sessions (SECRET) ---
SESSION_SECRET=change-me

# --- Azure OpenAI (the only model provider) ---
# AZURE_OPENAI_ENDPOINT=https://slipro-openai-stage.openai.azure.com/
# AZURE_OPENAI_KEY=            # (SECRET) omit to use managed identity / az login
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# Deployment names created in Azure AI Foundry (NOT model names). Which
# deployment backs which tier is configuration, so re-pointing a tier is an
# environment change and not a code change:
#   flagship  Foundation Sessions, SLI generation/refinement
#   mid       intake, daily prompts, journal/drift, analysis, content drafts
#   nano      classification, tagging, turn-typing, routing
#
# _MID is the fallback for any tier left unset, so it is the one that must be
# present. A missing _NANO degrades (nano work runs on mid); a missing _MID
# fails readiness.
# AZURE_OPENAI_DEPLOYMENT_FLAGSHIP=
# AZURE_OPENAI_DEPLOYMENT_MID=
# AZURE_OPENAI_DEPLOYMENT_NANO=
# AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=
# Speech-to-text deployment for voice transcription.
# whisper-1 / gpt-4o-transcribe / gpt-4o-mini-transcribe retired ~June 2026;
# gpt-4o-transcribe-diarize is the current GA option.
# AZURE_OPENAI_DEPLOYMENT_TRANSCRIBE=

# --- Blob Storage ---
# Storage account name only (not a connection string) — auth uses managed
# identity in Azure / your `az login` session locally. Leave unset to keep
# storing uploads as inline base64 in Postgres (legacy behaviour).
# AZURE_STORAGE_ACCOUNT=sliprostageblob

# --- Email: SendGrid (SECRET) ---
SENDGRID_API_KEY=

# --- Payments: Stripe (SECRET) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth: LinkedIn OIDC (SECRET) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Point this at the Azure/Front Door domain in staging/production.
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# --- Debug ---
# DEBUG_SLI=

# ─────────────────────────────────────────────────────────────────────────────
# REMOVED — set nothing here, the app reads none of it:
#   REPLIT_DEV_DOMAIN, REPLIT_DEPLOYMENT      (Replit-only)
#   LLM_PROVIDER                              (Azure OpenAI is the only one)
#   ANTHROPIC_API_KEY, ANTHROPIC_MODEL_*, CLAUDE_MODEL
#
# The second provider is gone rather than dormant. While it existed, an unset
# AZURE_OPENAI_ENDPOINT did not fail — it silently routed elsewhere and
# surfaced as an authentication error a long way from the missing variable.
# Delete these from any Key Vault and any local .env; nothing reads them, and
# leaving a stale ANTHROPIC-API-KEY secret in the vault is a live credential
# with no purpose.
# ─────────────────────────────────────────────────────────────────────────────

# Deployments that reject an explicit `temperature` — an ESCAPE HATCH, not the
# mechanism.
#
# GPT-5 and o-series deployments are recognised by name automatically, so
# `gpt-5.6-luna` and the like need no configuration. Set this only for a
# deployment whose name says nothing about the model behind it, e.g. a GPT-5
# deployment somebody named "prod-a". Comma-separated.
# FIXED_TEMPERATURE_DEPLOYMENTS=
