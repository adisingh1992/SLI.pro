# Dependencies are installed inside the image; copying the host's node_modules
# would also drag in platform-specific binaries (esbuild, pg) built for macOS.
node_modules
**/node_modules

# Build output (produced in the builder stage)
dist
client/dist

# Secrets and local config — must never enter the image
.env
.env.*
!.env.example

# VCS / editor / OS
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Replit remnants
.replit
replit.nix
replit.md
replit_agent
.repl_history

# Docs, planning and assets not needed at runtime
*.md
!README.md
attached_assets
test
.config
.local
.agents

# Logs and archives
*.log
logs
*.tar.gz
cookies.txt
generated-icon.png
